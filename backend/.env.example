PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=

# URL base del servidor (se usa en el link del mail de verificación)
BASE_URL=http://localhost:3000

# Correo (SMTP). Para Gmail usá una contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=


#Clave jwt-token
JWT_SECRET="Contraseña_generada"
JWT_EXPIRES=7d

#Claves de google para vincular con cuenta google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=